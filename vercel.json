{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "apps/docs/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [{ "source": "/desktop/getting-started/introduction", "destination": "/", "permanent": true }],
  "rewrites": [{ "source": "/design-system/desktop", "destination": "/index.html" }, { "source": "/design-system/tahoe", "destination": "/index.html" }]
}
